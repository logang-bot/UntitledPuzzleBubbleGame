# This .gitignore is for a Unity project.
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size and may contain sensitive data
/[Mm]emoryCaptures/

# Unity Recorder output can get excessive in size
/[Rr]ecordings/

# Uncomment if you add the Asset Store Tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / editor cache
.vs/
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Gradle cache directory (Android builds)
.gradle/

# Autogenerated VS/Rider/MonoDevelop solution and project files
# (regenerated by Unity/the IDE on demand, don't need to be tracked)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.tmp

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash report file
sysinfo.txt

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Screenshots taken while working/testing in the Unity Editor
# (Game view captures, Recorder image sequences, manual test screenshots, etc.)
[Ss]creenshots/
*.screenshot
*.screenshot.png
