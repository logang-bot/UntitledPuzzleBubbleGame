# Normalize line endings for everything by default, checked out as LF.
* text=auto eol=lf

# Code
*.cs text eol=lf diff=csharp
*.cginc text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf

# Docs / config
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Unity YAML-based assets (kept as text so diffs are readable; still merge
# poorly without UnityYAMLMerge configured, so prefer avoiding concurrent
# edits to the same scene/prefab)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.physicsMaterial2D text eol=lf
*.physicMaterial text eol=lf
*.inputactions text eol=lf

# Binary assets - never touch line endings on these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.ttf binary
*.otf binary
*.unitypackage binary
